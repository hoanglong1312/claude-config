{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(claude mcp *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(npm run build*)",
      "Bash(npm run qa*)",
      "Bash(npm run test*)",
      "Bash(npx playwright test*)",
      "Bash(npx tsc*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(rtk *)",
      "Bash(cd *)",
      "Bash(vercel*)",
      "Bash(curl *)",
      "Bash(curl*)",
      "Bash(sleep *)",
      "Bash(cat *)",
      "Bash(npm run dev*)",
      "Bash(npm run dev *)",
      "Bash(cmux browser *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/security-gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking security-review gate before commit..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/test-guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking tests not deleted/skipped before commit..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "ponytail@ponytail": false,
    "superpowers@claude-plugins-official": false,
    "caveman@caveman": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "supabase@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "effortLevel": "medium",
  "autoCompactWindow": 300000,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "outputStyle": "Explanatory"
}